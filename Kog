<body>
    <!-- Login/Signup Form -->
    <div id="authContainer" class="login-container">
        <h1 id="authTitle" class="login-title">Login</h1>
        <div class="input-group">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="Enter your email" required>
        </div>
        <div class="input-group">
            <label for="password">Password</label>
            <input type="password" id="password" placeholder="Enter your password" required>
        </div>
        <button id="authBtn" class="login-btn" onclick="handleAuth()">Login</button>
        <div class="toggle-text" onclick="toggleAuthMode()">Create an Account</div>
    </div>

    <!-- Main Content (Hidden initially) -->
    <div id="mainContent" class="main-content">
        <!-- Navigation Bar -->
        <nav class="navbar">
            <button class="nav-btn active" onclick="showPage('home')">Home</button>
            <button class="nav-btn" onclick="showPage('about')">About</button>
            <button class="nav-btn" onclick="showPage('account')">Account</button>
        </nav>

        <!-- Home Page -->
        <div id="home" class="page active">
            <div class="score-display">
                <div class="score-text">Total KOG Points</div>
                <div id="score" class="score-number">0</div>
            </div>
            <button id="kogButton" class="kog-button" onclick="incrementScore()">KOG</button>
        </div>

        <!-- About Page -->
        <div id="about" class="page">
            <div class="about-content">
                <h1 class="about-title">About KOG</h1>
                <p class="about-text">Welcome to KOG - the ultimate clicker game experience!</p>
                <p class="about-text">KOG stands for "King of Games" and is designed to bring you endless entertainment through simple yet addictive gameplay.</p>
                <p class="about-text">Click the big KOG button to earn points and watch your score grow. The more you click, the more powerful you become!</p>
                <p class="about-text">Earn 10,000 KOG Points to withdraw 0.000001 BTC to your Bitcoin wallet. Keep clicking to reach your withdrawal goal!</p>
                <p class="about-text">Enjoy the game and may your clicking finger never tire!</p>
            </div>
        </div>

        <!-- Account Page -->
        <div id="account" class="page">
            <div class="withdraw-container">
                <h1 class="withdraw-title">Withdraw</h1>
                <div class="withdraw-info">
                    <p><strong>Withdrawal Rate:</strong> 10,000 KOG Points = 0.000001 BTC</p>
                    <p><strong>Minimum Withdrawal:</strong> 10,000 KOG Points</p>
                </div>
                <p class="withdraw-amount">Available Balance: <span id="balance">0</span> KOG Points</p>
                <div class="btc-input-group">
                    <label for="btcAddress">Bitcoin Address</label>
                    <input type="text" id="btcAddress" placeholder="Enter your BTC wallet address" maxlength="50">
                </div>
                <button id="withdrawBtn" class="withdraw-btn" onclick="withdrawPoints()" disabled>Withdraw Points</button>
                <div id="successMessage" class="success-message message">Withdrawal request submitted successfully!</div>
                <div id="errorMessage" class="error-message message">Please enter a valid Bitcoin address and ensure you have enough points.</div>
            </div>
        </div>
    </div>

    <script>
        // Global variables
        let score = 0;
        let currentBalance = 0;
        let isLoginMode = true;

        // DOM elements
        const authContainer = document.getElementById('authContainer');
        const mainContent = document.getElementById('mainContent');
        const authTitle = document.getElementById('authTitle');
        const authBtn = document.getElementById('authBtn');
        const scoreElement = document.getElementById('score');
        const balanceElement = document.getElementById('balance');
        const withdrawBtn = document.getElementById('withdrawBtn');
        const successMessage = document.getElementById('successMessage');
        const errorMessage = document.getElementById('errorMessage');

        // Toggle between login and signup
        function toggleAuthMode() {
            isLoginMode = !isLoginMode;
            if (isLoginMode) {
                authTitle.textContent = 'Login';
                authBtn.textContent = 'Login';
                document.querySelector('.toggle-text').textContent = 'Create an Account';
            } else {
                authTitle.textContent = 'Create Account';
                authBtn.textContent = 'Create Account';
                document.querySelector('.toggle-text').textContent = 'Already have an account? Login';
            }
        }

        // Handle authentication
        function handleAuth() {
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            
            if (!email || !password) {
                alert('Please fill in all fields');
                return;
            }
            
            // Simple validation (in real app, this would be server-side)
            if (isLoginMode) {
                // Login logic
                alert('Login successful!');
            } else {
                // Signup logic
                alert('Account created successfully!');
            }
            
            // Hide auth container and show main content
            authContainer.style.display = 'none';
            mainContent.style.display = 'flex';
        }

        // Show page function
        function showPage(pageId) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            
            // Show selected page
            document.getElementById(pageId).classList.add('active');
            
            // Update nav buttons
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Find and activate the correct nav button
            const navButtons = document.querySelectorAll('.nav-btn');
            navButtons.forEach(btn => {
                if (btn.textContent.toLowerCase() === pageId) {
                    btn.classList.add('active');
                }
            });
            
            // Update balance display when showing account page
            if (pageId === 'account') {
                balanceElement.textContent = currentBalance;
                withdrawBtn.disabled = currentBalance < 10000;
            }
        }

        // Increment score function
        function incrementScore() {
            score++;
            scoreElement.textContent = score;
            currentBalance = score;
            balanceElement.textContent = currentBalance;
            withdrawBtn.disabled = currentBalance < 10000;
            
            // Add click animation effect
            const kogButton = document.getElementById('kogButton');
            kogButton.style.transform = 'scale(0.95)';
            setTimeout(() => {
                kogButton.style.transform = 'scale(1)';
            }, 100);
        }

        // Validate Bitcoin address (basic validation)
        function isValidBitcoinAddress(address) {
            // Basic validation - Bitcoin addresses are typically 26-35 characters
            // and start with 1, 3, or bc1
            const bitcoinRegex = /^(bc1|[13])[a-zA-HJ-NP-Z0-9]{25,39}$/;
            return bitcoinRegex.test(address);
        }

        // Withdraw points function
        function withdrawPoints() {
            const btcAddress = document.getElementById('btcAddress').value.trim();
            const pointsToWithdraw = currentBalance;
            
            // Validation
            if (pointsToWithdraw < 10000) {
                showError('You need at least 10,000 KOG Points to withdraw.');
                return;
            }
            
            if (!btcAddress) {
                showError('Please enter your Bitcoin address.');
                return;
            }
            
            if (!isValidBitcoinAddress(btcAddress)) {
                showError('Please enter a valid Bitcoin address.');
                return;
            }
            
            // Calculate BTC amount
            const btcAmount = (pointsToWithdraw / 10000) * 0.000001;
            
            // Show success message
            showSuccess(`Withdrawal request submitted! ${pointsToWithdraw.toLocaleString()} KOG Points = ${btcAmount} BTC will be sent to your address.`);
            
            // Reset balance
            currentBalance = 0;
            score = 0;
            scoreElement.textContent = score;
            balanceElement.textContent = currentBalance;
            withdrawBtn.disabled = true;
            document.getElementById('btcAddress').value = '';
            
            // Hide messages after 3 seconds
            setTimeout(() => {
                successMessage.classList.remove('show');
                errorMessage.classList.remove('show');
            }, 3000);
        }

        function showSuccess(message) {
            successMessage.textContent = message;
            successMessage.classList.add('show');
            errorMessage.classList.remove('show');
        }

        function showError(message) {
            errorMessage.textContent = message;
            errorMessage.classList.add('show');
            successMessage.classList.remove('show');
        }
    </script>
</body>
</html>
